HELPDESK_ENV=development
HELPDESK_PORT=8010
# Shared only by PHP and Next.js server; generate >=32 random characters.
HELPDESK_BRIDGE_SECRET=
HELPDESK_DATABASE_URL=sqlite:var/helpdesk.sqlite
HELPDESK_DB_USER=
HELPDESK_DB_PASSWORD=
HELPDESK_DB_SSL_CA=
HELPDESK_ALLOW_PRODUCTION_MIGRATIONS=false
HELPDESK_FRONTEND_ORIGIN=http://localhost:3000
HELPDESK_RETENTION_HOURS=24
HELPDESK_RATE_LIMIT=30
HELPDESK_MAX_AGENT_STEPS=5
HELPDESK_MAX_TOOL_CALLS=6
HELPDESK_TURN_TIMEOUT_SECONDS=55
# Empty means no support operator access, regardless of role.
HELPDESK_SUPPORT_USER_IDS=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=
NINEROUTER_TIMEOUT_SECONDS=12
NINEROUTER_MAX_RETRIES=2
NINEROUTER_JSON_MODE=true
# Explicit capability switch; a smoke test is optional, not required for startup.
NINEROUTER_TOOL_CALLING_ENABLED=true
# Public room tools remain hidden until catalog-smoke.php succeeds.
STUDIOHUB_API_BASE_URL=http://127.0.0.1:8000/api
STUDIOHUB_PUBLIC_TOOLS=false
