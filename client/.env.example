# REST mode serves the marketplace through the same-origin Next.js proxy.
NEXT_PUBLIC_APP_MODE=rest
# Public base is only used to render media URLs; auth and API calls use /api/rest.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only backend origin used by the Next.js proxy. In Compose use http://api.
API_INTERNAL_URL=http://127.0.0.1:8000
APP_ORIGIN=http://127.0.0.1:3000
