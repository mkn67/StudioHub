# Local Docker Compose settings. Existing MySQL volumes keep their old credentials.
COMPOSE_PROJECT_NAME=studiohub
DB_NAME=studio_dev
DB_USER=studio_user
DB_PASSWORD=studio_password
DB_ROOT_PASSWORD=root_password
DB_PORT=3307
API_PORT=8000
CLIENT_PORT=3000
HELPDESK_PORT=8010
# Leave empty to follow API_PORT / CLIENT_PORT. Set only for a custom public URL.
NEXT_PUBLIC_API_URL=
FRONTEND_ORIGIN=

# Generated locally by node scripts/setup-docker.mjs; never commit real values.
JWT_SECRET=
HELPDESK_BRIDGE_SECRET=

# Gateway runs on the host. API key/model remain in helpdesk-php/.env.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
