# Local Podman/Docker Compose only. Keep production/Aiven settings in server/.env.
COMPOSE_PROJECT_NAME=studiohub
LOCAL_DB_NAME=studio_dev
LOCAL_DB_USER=studio_user
LOCAL_DB_PASSWORD=studio_password
LOCAL_DB_ROOT_PASSWORD=root_password
LOCAL_DB_PORT=3307
LOCAL_API_PORT=8000
LOCAL_CLIENT_PORT=3000
LOCAL_HELPDESK_PORT=8010
# Leave blank to derive URLs from LOCAL_API_PORT / LOCAL_CLIENT_PORT.
LOCAL_NEXT_PUBLIC_API_URL=
LOCAL_FRONTEND_ORIGIN=

# Generated by scripts/setup-docker.mjs. Do not commit real secrets.
LOCAL_JWT_SECRET=
LOCAL_HELPDESK_BRIDGE_SECRET=

# Gateway runs on the host. Provider API keys stay in helpdesk-php/.env.
LOCAL_NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
