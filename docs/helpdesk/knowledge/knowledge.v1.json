    {
      "id": "KB-015",
      "slug": "statuses",
      "title": "Các trạng thái đơn thuê có nghĩa gì?",
      "topic": "statuses",
      "content": "Theo chính sách: awaiting_payment là chờ cọc; pending là đã cọc chờ Host; confirmed là đã được Host duyệt; checked_in là Host xác nhận nhận phòng; completed là Host xác nhận trả phòng; cancelled là đã hủy; expired là hết hạn thanh toán; no_show là hết ca mà chưa có check-in xác nhận. Đây không phải kết quả tra cứu đơn.",
      "sources": [
        {
          "document": "client/docs/references/StudioHub_Business_Policy_VI_v1.1.md",
          "reference": "BP-16",
          "version": "1.1"
