# Local Compose: dev. Render must set APP_ENV=production.
APP_ENV=dev
JWT_SECRET=supersecretjwtkey_change_in_production_min32chars
DB_HOST=db
DB_PORT=3306
DB_NAME=studio_dev
DB_USER=studio_user
DB_PASSWORD=studio_password
DB_PASS=studio_password
# Required on Render/Aiven; upload the CA as a secret file and set its mounted path.
DB_SSL_CA=
# Optional. Keep false in production unless you intentionally need example catalog rows.
SEED_EXAMPLE_CATALOG=false
# Optional once-only repair/import of recognised demo rooms. Leave blank normally.
DEMO_CATALOG_UPDATE=
# Exact connected database name; mandatory when enabling v2 above.
DEMO_CATALOG_DATABASE=
ALLOWED_ORIGINS=http://localhost:3000
DEPOSIT_RATE=0.30
HOLD_MINUTES=15
SERVICE_ORDER_HOLD_MINUTES=15
HOST_RESPONSE_HOURS=24
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
AVAILABILITY_RATE_LIMIT=60
AVAILABILITY_RATE_WINDOW_SECONDS=60
OPERATING_HOURS=12
BUFFER_MINUTES=30
